<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept in the project rather than left to be generated, because the generated
  one is not enough and the difference is not visible until the site is down.

  This app is a child application under the WordPress at kuleni.com.na. An
  IIS child inherits its parent's rewrite rules, and the parent's send
  everything to WordPress - so they are dropped here, for this application
  only. It was on the server as a hand edit; a publish would have written over
  it, which is why it now lives here and is published with the rest.

  <clear /> rather than <remove name="..." />. Removing by name has to name
  the parent's rule exactly, and twice now it has not: the name in this file
  read "WordPress: http://localhost:84" while the server's read "WordPress:
  https://www.kuleni.com.na", and neither matched what the parent actually
  had. A rule that is not removed sends every stylesheet, script and image
  under /gepf/ to WordPress, which answers its own 404 page to all of them -
  and the calculator arrives looking like it loaded, unstyled and inert.

  Nothing here needs a rewrite rule of any kind: ASP.NET Core routes the whole
  application itself. So drop the lot, and there is no name left to get wrong.

  dotnet publish fills in the <aspNetCore> element below (the DLL to run and
  the hosting model); everything else is passed through as written.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\GEPF.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>

  <system.webServer>
    <rewrite>
      <rules>
        <clear />
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
