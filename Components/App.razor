<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Wherever the app has been hung. At a site's root that is "/", and under
       a path it is that path — /gepf/ on kuleni.com.na, where this runs as a
       child application under the site. Written out rather than fixed at "/",
       because every stylesheet, script and image below is asked for relative
       to it: at "/" they would be fetched from the parent site's root, which
       is a WordPress that has never heard of them. *@
    <base href="@BaseHref" />
    <link rel="icon" type="image/png" href="images/kuleni-logo-favicon.png" />
    <link rel="apple-touch-icon" href="images/kuleni-logo-favicon.png" />
    @* The same three, in the same order, as the loan application: Bootstrap
       first, the house stylesheet over it, and the little that belongs to
       this app alone last. *@
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/site.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        Something went wrong.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">&#128473;</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    @* Mandatory fields mark themselves green as they are filled in and red
       once left empty — the same behaviour as every form in the loan
       application, from the same file. *@
    <script src="js/live-validation.js"></script>
    <script src="js/sidebar.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// The path the app is served under, with a trailing slash: "/" at a site
    /// root, "/gepf/" under one. IIS sets it for a child application and the
    /// framework hands it over here; nothing has to be configured or guessed.
    /// </summary>
    private string BaseHref
    {
        get
        {
            var pathBase = (HttpContext?.Request.PathBase.Value ?? string.Empty).Trim('/');
            return pathBase.Length == 0 ? "/" : $"/{pathBase}/";
        }
    }
}
